---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, NAV_LINKS } from '../consts';
---

<header>
	<nav class="container">
		<a href="/" class="brand" aria-label={SITE_TITLE}>
			<img src="/celiacos_guatemala_logo.svg" alt={SITE_TITLE} class="brand-logo" width="126" height="40" />
		</a>

		<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
		<label for="nav-toggle" class="nav-burger" aria-label="Abrir menú">
			<span></span><span></span><span></span>
		</label>

		<div class="links">
			{NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 68px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.brand-logo {
		display: block;
		height: 40px;
		width: auto;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	.nav-toggle,
	.nav-burger {
		display: none;
	}
	.nav-burger {
		flex-direction: column;
		gap: 5px;
		cursor: pointer;
		padding: 8px;
	}
	.nav-burger span {
		width: 24px;
		height: 2px;
		background: rgb(var(--ink));
		border-radius: 2px;
		transition: 0.2s ease;
	}
	@media (max-width: 860px) {
		.nav-burger {
			display: flex;
		}
		.links {
			position: absolute;
			top: 68px;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			background: #fff;
			border-bottom: 1px solid rgb(var(--gray-light));
			padding: 0.5rem 1.25rem 1.25rem;
			box-shadow: var(--box-shadow);
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			pointer-events: none;
			transition: 0.25s ease;
		}
		.nav-toggle:checked ~ .links {
			max-height: 80vh;
			opacity: 1;
			pointer-events: auto;
			padding-top: 1rem;
		}
	}
</style>
