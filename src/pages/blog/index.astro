---
import Page from '../../layouts/Page.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
---

<Page
	title="Blog — Celiacos Guatemala"
	description="Recetas, guías prácticas, novedades y recursos para vivir mejor sin gluten en Guatemala."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Blog y recursos</span>
			<h1>Vivir bien sin gluten</h1>
			<p>Guías prácticas, recetas, ciencia sin mitos y novedades de la comunidad celíaca.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				featured && (
					<a href={`/blog/${featured.id}/`} class="featured">
						<img src={featured.data.heroImage} alt="" />
						<div class="featured-body">
							<span class="badge">Destacado</span>
							<h2>{featured.data.title}</h2>
							<p>{featured.data.description}</p>
							<span class="date"><FormattedDate date={featured.data.pubDate} /></span>
						</div>
					</a>
				)
			}

			<div class="grid grid-3 posts">
				{
					rest.map((post) => (
						<a href={`/blog/${post.id}/`} class="card post-card">
							<img src={post.data.heroImage} alt="" class="post-img" />
							<div class="post-body">
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Page>

<style>
	.page-hero {
		background: rgb(var(--green-light));
		padding: 3.5rem 0;
		text-align: center;
	}
	.page-hero p {
		max-width: 56ch;
		margin: 0.5rem auto 0;
		font-size: 1.12rem;
		color: rgb(var(--gray-dark));
	}
	.featured {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 0;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		margin-bottom: 2.5rem;
		transition: box-shadow 0.2s ease;
	}
	.featured:hover {
		box-shadow: var(--box-shadow);
	}
	.featured img {
		width: 100%;
		height: 100%;
		min-height: 280px;
		object-fit: cover;
		border-radius: 0;
	}
	.featured-body {
		padding: 2.2rem;
		align-self: center;
	}
	.featured-body h2 {
		margin: 0.7rem 0;
	}
	.featured-body p {
		color: rgb(var(--gray));
	}
	.post-card {
		padding: 0;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
	}
	.post-img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0;
	}
	.post-body {
		padding: 1.4rem;
	}
	.post-card h3 {
		font-size: 1.2rem;
		margin: 0.4rem 0;
	}
	.post-card p {
		font-size: 0.93rem;
		color: rgb(var(--gray));
		margin: 0;
	}
	.date {
		font-size: 0.85rem;
		color: rgb(var(--wheat));
		font-weight: 700;
	}
	@media (max-width: 700px) {
		.featured {
			grid-template-columns: 1fr;
		}
		.featured img {
			min-height: 200px;
		}
	}
</style>
