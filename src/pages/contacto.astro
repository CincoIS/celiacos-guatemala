---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import { ORG, SOCIAL_LINKS } from '../consts';

const donations = [
	{ amount: 'Q75', text: 'Una despensa básica sin gluten para una semana.' },
	{ amount: 'Q200', text: 'Cubre una prueba de tamizaje para una persona.' },
	{ amount: 'Q500', text: 'Un taller de cocina segura para diez familias.' },
];
---

<Page
	title="Contacto y Donaciones — Celiacos Guatemala"
	description="Escríbenos, hazte voluntario o realiza una donación. Estamos en la Zona 10 de la Ciudad de Guatemala y respondemos por correo, teléfono y WhatsApp."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Contacto</span>
			<h1>Estamos para acompañarte</h1>
			<p>¿Tienes dudas, quieres ser voluntario o necesitas orientación? Escríbenos: te respondemos pronto.</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-grid">
			<div class="contact-info">
				<h2>Datos de contacto</h2>
				<ul>
					<li><span class="ci"><Icon name="pin" size={20} /></span><div><strong>Dirección</strong><br />{ORG.address}</div></li>
					<li><span class="ci"><Icon name="mail" size={20} /></span><div><strong>Correo</strong><br /><a href={`mailto:${ORG.email}`}>{ORG.email}</a></div></li>
					<li><span class="ci"><Icon name="phone" size={20} /></span><div><strong>Teléfono</strong><br /><a href={`tel:${ORG.phone.replace(/\s/g, '')}`}>{ORG.phone}</a></div></li>
					<li><span class="ci"><Icon name="phone" size={20} /></span><div><strong>WhatsApp</strong><br />{ORG.whatsapp}</div></li>
					<li><span class="ci"><Icon name="clock" size={20} /></span><div><strong>Horario</strong><br />{ORG.hours}</div></li>
				</ul>
				<div class="socials">
					<a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={20} /></a>
					<a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={20} /></a>
					<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" size={20} /></a>
				</div>
			</div>

			<form class="contact-form" onsubmit="event.preventDefault(); this.reset(); document.getElementById('form-msg').hidden = false;">
				<h2>Envíanos un mensaje</h2>
				<div class="field">
					<label for="nombre">Nombre completo</label>
					<input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" />
				</div>
				<div class="row">
					<div class="field">
						<label for="email">Correo</label>
						<input id="email" name="email" type="email" required placeholder="tucorreo@ejemplo.com" />
					</div>
					<div class="field">
						<label for="motivo">Motivo</label>
						<select id="motivo" name="motivo">
							<option>Quiero orientación</option>
							<option>Quiero ser voluntario</option>
							<option>Soy comercio y busco el Sello Sin Gluten</option>
							<option>Donaciones</option>
							<option>Prensa / alianzas</option>
						</select>
					</div>
				</div>
				<div class="field">
					<label for="mensaje">Mensaje</label>
					<textarea id="mensaje" name="mensaje" rows="5" required placeholder="Cuéntanos cómo podemos ayudarte"></textarea>
				</div>
				<button type="submit" class="btn btn--primary">Enviar mensaje <Icon name="arrow" size={18} /></button>
				<p id="form-msg" class="form-msg" hidden>¡Gracias! Hemos recibido tu mensaje y te responderemos pronto. (Demostración)</p>
			</form>
		</div>
	</section>

	<section id="donar" class="section section--green donate">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Donaciones</span>
				<h2>Tu donación transforma vidas</h2>
				<p>Cada aporte acerca un diagnóstico digno y una comida segura a una familia guatemalteca.</p>
			</div>
			<div class="grid grid-3">
				{
					donations.map((d) => (
						<div class="card donate-card">
							<span class="amount">{d.amount}</span>
							<p>{d.text}</p>
							<a href="#donar" class="btn btn--wheat">Donar {d.amount}</a>
						</div>
					))
				}
			</div>
			<div class="bank">
				<h3>Donación por transferencia</h3>
				<p>
					<strong>{ORG.legalName}</strong><br />
					Banco Industrial · Cuenta Monetaria No. 123-456789-0<br />
					Envía tu comprobante a <a href={`mailto:${ORG.email}`}>{ORG.email}</a> para recibir tu recibo.
				</p>
			</div>
		</div>
	</section>
</Page>

<style>
	.page-hero {
		background: rgb(var(--green-light));
		padding: 3.5rem 0;
		text-align: center;
	}
	.page-hero p {
		max-width: 58ch;
		margin: 0.5rem auto 0;
		font-size: 1.12rem;
		color: rgb(var(--gray-dark));
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 3rem;
		align-items: start;
	}
	.contact-info ul {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}
	.contact-info li {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		margin-bottom: 1.1rem;
	}
	.ci {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 11px;
		background: rgb(var(--green-light));
		color: rgb(var(--green-dark));
		flex-shrink: 0;
	}
	.contact-info a {
		color: rgb(var(--green-dark));
	}
	.socials {
		display: flex;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}
	.socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 11px;
		background: rgb(var(--green));
		color: #fff;
		transition: 0.2s ease;
	}
	.socials a:hover {
		background: rgb(var(--green-dark));
	}
	.contact-form {
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		padding: 2rem;
		box-shadow: var(--box-shadow);
	}
	.field {
		margin-bottom: 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	label {
		font-weight: 600;
		font-size: 0.92rem;
		color: rgb(var(--gray-dark));
	}
	input,
	select,
	textarea {
		width: 100%;
		padding: 0.7rem 0.9rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: rgb(var(--cream));
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-color: rgb(var(--green));
		box-shadow: 0 0 0 3px rgba(var(--green), 0.15);
	}
	.form-msg {
		margin: 1rem 0 0;
		padding: 0.8rem 1rem;
		background: rgb(var(--green-light));
		color: rgb(var(--green-dark));
		border-radius: 10px;
		font-weight: 600;
	}
	.donate {
		scroll-margin-top: 80px;
	}
	.donate-card {
		text-align: center;
	}
	.amount {
		display: block;
		font-size: 2.2rem;
		font-weight: 700;
		color: rgb(var(--green-dark));
		margin-bottom: 0.5rem;
	}
	.donate-card p {
		margin-bottom: 1.2rem;
	}
	.bank {
		background: #fff;
		border-radius: var(--radius);
		padding: 1.8rem;
		margin-top: 2rem;
		text-align: center;
		border: 1px dashed rgb(var(--green));
	}
	.bank p {
		margin: 0.5rem 0 0;
	}
	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
		.row {
			grid-template-columns: 1fr;
		}
	}
</style>
