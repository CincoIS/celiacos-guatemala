---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, STATS, FOCUS, VALUES } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Page title={`${SITE_TITLE} — Información con evidencia, incidencia con propósito`} description={SITE_DESCRIPTION}>
	<!-- Hero -->
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="badge">Recurso independiente · basado en evidencia</span>
				<h1>La celiaquía en Guatemala,<br /><span class="hl">con rigor y contexto</span></h1>
				<p>
					Guatemala no tiene una asociación nacional de pacientes celíacos, ni una ley de celiaquía,
					ni datos epidemiológicos propios. Reunimos información verificable sobre la enfermedad y
					documentamos esos vacíos para impulsar una mejor política pública.
				</p>
				<div class="hero-actions">
					<a href="/que-es-la-celiaquia" class="btn btn--primary">Entender la celiaquía <Icon name="arrow" size={18} /></a>
					<a href="/incidencia" class="btn btn--ghost">La brecha de política pública</a>
				</div>
			</div>
			<div class="hero-card">
				<img src="/blog-placeholder-about.jpg" alt="Tortillas de maíz, base naturalmente sin gluten de la dieta guatemalteca" />
				<div class="hero-float">
					<span class="hero-float-num">0.46–0.64 %</span>
					<span>prevalencia estimada en Latinoamérica</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Key facts -->
	<section class="section--green stats-band">
		<div class="container grid grid-4">
			{
				STATS.map((s) => (
					<div class="stat">
						<span class="stat-num">{s.value}</span>
						<span class="stat-label">{s.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<!-- The reality in Guatemala -->
	<section class="section">
		<div class="container reality-grid">
			<div>
				<span class="eyebrow">El panorama nacional</span>
				<h2>Tres pilares que a Guatemala le faltan</h2>
				<p>
					La atención existe —laboratorios privados, gastroenterólogos y la Unidad de
					Gastroenterología del Hospital Roosevelt— pero está concentrada en el sector privado de la
					capital. Lo que no existe es la infraestructura pública e institucional que sí tienen otros
					países de la región.
				</p>
				<a href="/incidencia" class="btn btn--primary">Ver el análisis completo <Icon name="arrow" size={18} /></a>
			</div>
			<ul class="gap-list">
				<li>
					<Icon name="users" size={22} />
					<div><strong>Sin asociación de pacientes.</strong> Guatemala no figura en los directorios internacionales de asociaciones celíacas.</div>
				</li>
				<li>
					<Icon name="scale" size={22} />
					<div><strong>Sin ley ni etiquetado propio.</strong> Aplica el reglamento centroamericano; no hay una norma nacional «sin gluten».</div>
				</li>
				<li>
					<Icon name="search" size={22} />
					<div><strong>Sin datos epidemiológicos.</strong> No existe un estudio poblacional ni un registro nacional.</div>
				</li>
			</ul>
		</div>
	</section>

	<!-- Cultural advantage -->
	<section class="section learn-band">
		<div class="container learn-grid">
			<div>
				<span class="eyebrow" style="color:#fff;">La ventaja del maíz</span>
				<h2 style="color:#fff;">La base de la dieta ya es segura</h2>
				<p>
					La dieta guatemalteca se sostiene en la tortilla de maíz, naturalmente libre de gluten. El
					principal reto para una persona celíaca aquí no es la falta de alimentos base seguros, sino
					la contaminación cruzada, el costo de los productos importados y la baja conciencia pública.
				</p>
				<a href="/vivir-sin-gluten" class="btn btn--light">Cómo vivir sin gluten en Guatemala</a>
			</div>
			<ul class="learn-points">
				<li><Icon name="check" size={20} /> Afecta cerca del 1 % de la población mundial</li>
				<li><Icon name="check" size={20} /> El único tratamiento es la dieta sin gluten de por vida</li>
				<li><Icon name="check" size={20} /> Una sola miga puede causar daño intestinal</li>
				<li><Icon name="check" size={20} /> No retires el gluten antes de hacerte las pruebas</li>
			</ul>
		</div>
	</section>

	<!-- Focus areas -->
	<section class="section section--cream">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">En qué trabajamos</span>
				<h2>Cuatro frentes, un mismo propósito</h2>
				<p>Información clara y verificable, y una agenda para cerrar la brecha de política pública.</p>
			</div>
			<div class="grid grid-4">
				{
					FOCUS.map((f) => (
						<a href={f.href} class="card focus-card">
							<span class="card-icon"><Icon name={f.icon} size={26} /></span>
							<h3>{f.title}</h3>
							<p>{f.summary}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- Principles -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Cómo trabajamos</span>
				<h2>Principios del proyecto</h2>
			</div>
			<div class="grid grid-4">
				{
					VALUES.map((v) => (
						<div class="card">
							<span class="card-icon"><Icon name={v.icon} size={26} /></span>
							<h4>{v.title}</h4>
							<p>{v.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Articles -->
	<section class="section section--cream">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Recursos</span>
				<h2>Guías y artículos</h2>
				<p>Material práctico y verificado para entender y manejar la celiaquía en Guatemala.</p>
			</div>
			<div class="grid grid-3">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="card post-card">
							<img src={post.data.heroImage} alt="" class="post-img" />
							<div class="post-body">
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
						</a>
					))
				}
			</div>
			<div style="text-align:center; margin-top:2.5rem;">
				<a href="/blog" class="btn btn--ghost">Ver todos los recursos</a>
			</div>
		</div>
	</section>

	<!-- Closing -->
	<section class="section final-cta">
		<div class="container">
			<h2>Información que sostiene mejores decisiones</h2>
			<p>
				Este es un recurso independiente y sin fines comerciales. Todas las afirmaciones se apoyan en
				literatura médica, normativa vigente o fuentes verificables, citadas y enlazadas.
			</p>
			<div class="hero-actions" style="justify-content:center;">
				<a href="/incidencia" class="btn btn--primary">Conoce la agenda de incidencia</a>
				<a href="/referencias" class="btn btn--ghost">Referencias y fuentes</a>
			</div>
		</div>
	</section>
</Page>

<style>
	.hero {
		background:
			radial-gradient(900px 400px at 80% -10%, rgba(var(--wheat), 0.18), transparent) rgb(var(--cream));
		padding: 4rem 0 4.5rem;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 3rem;
		align-items: center;
	}
	.hero-copy h1 {
		font-size: 3.2rem;
		margin: 1rem 0;
	}
	.hl {
		color: rgb(var(--green));
	}
	.hero-copy p {
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
		max-width: 52ch;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 1.8rem;
	}
	.hero-card {
		position: relative;
	}
	.hero-card img {
		width: 100%;
		border-radius: 20px;
		box-shadow: var(--box-shadow);
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.hero-float {
		position: absolute;
		bottom: -22px;
		left: -22px;
		background: #fff;
		border-radius: 16px;
		padding: 1rem 1.3rem;
		box-shadow: var(--box-shadow);
		display: flex;
		flex-direction: column;
		line-height: 1.2;
		max-width: 220px;
	}
	.hero-float-num {
		font-size: 1.5rem;
		font-weight: 700;
		color: rgb(var(--green));
	}
	.hero-float span:last-child {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.stats-band {
		padding: 2.6rem 0;
	}
	.stat {
		text-align: center;
	}
	.stat-num {
		display: block;
		font-size: 1.9rem;
		font-weight: 700;
		color: rgb(var(--green-dark));
	}
	.stat-label {
		font-size: 0.92rem;
		color: rgb(var(--gray-dark));
	}

	.reality-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.gap-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	.gap-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		padding: 1.1rem 1.3rem;
	}
	.gap-list :global(svg) {
		color: rgb(var(--green));
		flex-shrink: 0;
		margin-top: 2px;
	}
	.gap-list strong {
		color: rgb(var(--ink));
	}

	.learn-band {
		background: linear-gradient(135deg, rgb(var(--ink)), rgb(var(--ink-2)));
	}
	.learn-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 2.5rem;
		align-items: center;
	}
	.learn-band p {
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.1rem;
		max-width: 52ch;
	}
	.learn-points {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.9rem;
	}
	.learn-points li {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		padding: 0.85rem 1.1rem;
		border-radius: 12px;
		font-weight: 600;
	}
	.learn-points :global(svg) {
		color: rgb(var(--wheat));
		flex-shrink: 0;
	}

	.focus-card {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.focus-card h3 {
		color: rgb(var(--ink));
		font-size: 1.15rem;
	}

	.post-card {
		padding: 0;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
	}
	.post-img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0;
	}
	.post-body {
		padding: 1.4rem;
	}
	.post-date {
		font-size: 0.85rem;
		color: rgb(var(--wheat));
		font-weight: 700;
	}
	.post-card h3 {
		font-size: 1.25rem;
		margin: 0.4rem 0;
	}
	.post-card p {
		font-size: 0.95rem;
	}

	.final-cta {
		text-align: center;
	}
	.final-cta p {
		max-width: 64ch;
		margin: 0 auto 1.5rem;
		font-size: 1.1rem;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 860px) {
		.hero-grid,
		.reality-grid,
		.learn-grid {
			grid-template-columns: 1fr;
		}
		.hero-copy h1 {
			font-size: 2.4rem;
		}
		.hero-card {
			order: -1;
		}
		.hero-float {
			left: 12px;
		}
	}
</style>
