		padding: 0.85rem 1.1rem;
		font-weight: 600;
	}
	.symptoms :global(svg) {
		color: rgb(var(--green));
		flex-shrink: 0;
	}
	.step-card {
		text-align: center;
	}
	.step-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgb(var(--green));
		color: #fff;
		font-weight: 700;
		font-size: 1.2rem;
		margin-bottom: 0.8rem;
	}
	.step-card p {
		font-size: 0.92rem;
	}
	.myth-card {
		background: #fff;
		border-radius: var(--radius);
		padding: 1.5rem;
		border: 1px solid rgba(var(--wheat), 0.4);
	}
	.myth {
