---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import { REFERENCES } from '../consts';

// Group references by category, preserving first-seen order.
const groups: { category: string; items: typeof REFERENCES }[] = [];
for (const ref of REFERENCES) {
	let group = groups.find((g) => g.category === ref.category);
	if (!group) {
		group = { category: ref.category, items: [] };
		groups.push(group);
	}
	group.items.push(ref);
}
---

<Page
	title="Referencias y fuentes — Celiacos Guatemala"
	description="Estudios, normativa, modelos regionales y directorios en los que se basa la información de Celiacos Guatemala, con enlaces a las fuentes originales."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Transparencia</span>
			<h1>Referencias y fuentes</h1>
			<p>
				Todo lo que publicamos se apoya en fuentes verificables. Aquí están las principales, con
				enlaces a los documentos originales para que puedas consultarlos directamente.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			{
				groups.map((g) => (
					<div class="ref-group">
						<h2>{g.category}</h2>
						<ul class="ref-list">
							{g.items.map((ref) => (
								<li class="ref">
									<span class="ref-icon"><Icon name="doc" size={20} /></span>
									<div class="ref-body">
										<h3>
											{ref.url ? (
												<a href={ref.url} target="_blank" rel="noopener">
													{ref.title} <Icon name="link" size={15} />
												</a>
											) : (
												ref.title
											)}
										</h3>
										<p class="ref-source">{ref.source}</p>
										<p class="ref-note">{ref.note}</p>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}

			<p class="ref-disclaimer">
				<Icon name="alert" size={18} />
				<span>
					Las cifras de prevalencia citadas son regionales u hospitalarias: Guatemala no cuenta con
					un estudio poblacional propio. Direcciones, precios y disponibilidad de productos y
					servicios pueden cambiar; confirma siempre antes de actuar.
				</span>
			</p>
		</div>
	</section>

	<section class="section join-band">
		<div class="container">
			<h2>¿Una fuente que deberíamos incluir?</h2>
			<p>Este listado crecerá conforme se publiquen nuevos estudios y normas relevantes para Guatemala.</p>
			<a href="/acerca" class="btn btn--wheat">Acerca del proyecto</a>
		</div>
	</section>
</Page>

<style>
	.page-hero {
		background: rgb(var(--green-light));
		padding: 3.5rem 0;
		text-align: center;
	}
	.page-hero p {
		max-width: 62ch;
		margin: 0.5rem auto 0;
		font-size: 1.12rem;
		color: rgb(var(--gray-dark));
	}
	.narrow {
		max-width: 820px;
	}
	.ref-group {
		margin-bottom: 2.5rem;
	}
	.ref-group h2 {
		font-size: 1.3rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid rgb(var(--green-light));
		margin-bottom: 1.2rem;
	}
	.ref-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	.ref {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		padding: 1.4rem 1.6rem;
	}
	.ref-icon {
		color: rgb(var(--green));
		flex-shrink: 0;
		margin-top: 2px;
	}
	.ref-body h3 {
		font-size: 1.05rem;
		margin-bottom: 0.3rem;
		line-height: 1.35;
	}
	.ref-body h3 a {
		display: inline;
	}
	.ref-body h3 :global(svg) {
		vertical-align: middle;
	}
	.ref-source {
		font-size: 0.88rem;
		font-weight: 600;
		color: rgb(var(--wheat));
		margin-bottom: 0.4rem;
	}
	.ref-note {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}
	.ref-disclaimer {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		margin-top: 2rem;
		padding: 1.2rem 1.4rem;
		background: rgb(var(--cream));
		border-radius: var(--radius);
		font-size: 0.92rem;
		color: rgb(var(--gray-dark));
	}
	.ref-disclaimer :global(svg) {
		color: rgb(var(--brand-dark));
		flex-shrink: 0;
		margin-top: 3px;
	}
	.join-band {
		text-align: center;
		background: linear-gradient(135deg, rgb(var(--ink)), rgb(var(--ink-2)));
		color: #fff;
	}
	.join-band h2 {
		color: #fff;
	}
	.join-band p {
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 1.5rem;
	}
</style>
